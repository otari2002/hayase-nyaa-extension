        { "label": "Anime - English-translated", "value": "1_2" },
        { "label": "Anime - Non-English-translated", "value": "1_3" },
        { "label": "Anime - Raw", "value": "1_4" },
        { "label": "Audio - Lossless", "value": "2_1" },
        { "label": "Literature - English-translated", "value": "3_1" }
