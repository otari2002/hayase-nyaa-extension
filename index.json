{
  "id": "hayase.extension.nyaa.custom",
  "name": "Nyaa Custom Scraper",
  "version": "1.1.0",
  "type": "torrent",
  "accuracy": "high",
  "media": "sub",
  "languages": ["EN", "JP"],
  "icon": "https://nyaa.si/static/favicon.png",
