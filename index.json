      "name": "Search Filter",
      "type": "select",
      "default": "0",
      "options": [
        { "label": "No Filter", "value": "0" },
        { "label": "No Remakes", "value": "1" },
        { "label": "Trusted Only", "value": "2" }
      ]
    }
  ]
}
